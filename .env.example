# OpenRouter API
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxx

# Discord Webhooks (un par canal)
DISCORD_WEBHOOK_CRITIQUE=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_IA=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_DEV=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_CLOUD=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_SECURITE=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_TENDANCES=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_DIGEST=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_HEBDO=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_WEBHOOK_STATUS=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# Veille ParlIA (docs/veille-parlia.md). Sans DISCORD_WEBHOOK_PARLIA, rien n'est publié : seul le fichier est écrit.
DISCORD_WEBHOOK_PARLIA=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
# 1 si le salon de la veille ParlIA est un forum (un post par semaine), 0 pour un salon texte
DISCORD_PARLIA_FORUM=0
# Identifiant Discord (chiffres) à mentionner dans l'ouverture, le rappel et les alertes ; vide : aucune mention
PARLIA_DISCORD_MENTION=
# Dossiers du Mac montés dans le conteneur ; vides : ./exports/veille-parlia et ./exports/veille-parlia-notes
PARLIA_EXPORT_DIR=
PARLIA_NOTES_DIR=
# Facultatif : jour (1 = lundi … 7 = dimanche) et heure de la préparation et du rappel, collecte toutes les N heures
# PARLIA_PREPARATION_JOUR=1
# PARLIA_PREPARATION_HEURE=06:00
# PARLIA_RAPPEL_JOUR=4
# PARLIA_RAPPEL_HEURE=16:30
# PARLIA_COLLECTE_HEURES=4

# N8N API (pour le MCP)
N8N_API_KEY=your_n8n_api_key
